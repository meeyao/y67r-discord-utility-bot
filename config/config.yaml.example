discord:
  # You can keep the token here for local testing, but prefer the CONVERTCORD_TOKEN env var.
  token: "YOUR_DISCORD_BOT_TOKEN"
  # The alias is the literal trigger word, defaulting to "$convert".
  alias: "$convert"
  # Optional list of extra aliases with their own triggers.
  additional_aliases:
    - "$currency"
    - "!roll"
    - "!conch"
    - "!time"
    - "!weather"
    - "%"
    - "!football"
    - "!wc"
    - "!fifa"
    - "!soccer"
    - "!team"
    - "!gta"
  # Optional safety rails. Leave empty to allow every channel / guild the bot can see.
  allowed_channel_ids: []
  allowed_guild_ids: []
  status: "metric ↔ imperial"

currency:
  # Targets that will be shown when the user omits the destination currency.
  default_targets:
    - USD
    - EUR
    - CAD
    - GBP
  cache_minutes: 180
  api_url: https://open.er-api.com/v6/latest/{base}

football:
  # Optional API key for football-data.org (free registration at https://www.football-data.org)
  # Without a key the API still works but with stricter rate limits.
  api_key: ""

sanitize:
  # Toggle per-platform link rewriting. Set twitch: false to keep Discord's native Twitch embeds.
  instagram: true
  reddit: true
  tiktok: true
  twitch: true
  twitter: true
  # If a link is posted that was already seen in the last 24h, react with ♻️
  detect_dupes: true
